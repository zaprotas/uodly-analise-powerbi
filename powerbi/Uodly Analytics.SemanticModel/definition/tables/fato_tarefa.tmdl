table fato_tarefa
	lineageTag: 51785053-407a-4729-904d-4e5c73aeac02

	measure Tentativas = COUNTROWS ( fato_tarefa )
		formatString: #,0
		displayFolder: Tarefas

	measure Concluíram = CALCULATE ( [Tentativas], fato_tarefa[concluiu] = TRUE () )
		formatString: #,0
		displayFolder: Tarefas

	measure 'Relataram sucesso' = CALCULATE ( [Tentativas], fato_tarefa[relato_sucesso] = TRUE () )
		formatString: #,0
		displayFolder: Tarefas

	measure 'Taxa de conclusão' = DIVIDE ( [Concluíram], [Tentativas] )
		formatString: 0.0%
		displayFolder: Tarefas

	measure 'Taxa de relato de sucesso' = DIVIDE ( [Relataram sucesso], [Tentativas] )
		formatString: 0.0%
		displayFolder: Tarefas

	measure 'Lacuna relato x execução' = [Taxa de relato de sucesso] - [Taxa de conclusão]
		formatString: 0.0%
		displayFolder: Tarefas

	measure 'Relatos falso-positivos' = CALCULATE ( [Tentativas], fato_tarefa[relato_falso_positivo] = TRUE () )
		formatString: #,0
		displayFolder: Tarefas

	/// Concordância observada: relatou sucesso tendo concluído, ou relatou
	/// fracasso tendo falhado. É a diagonal principal da matriz 2x2.
	measure 'Concordância observada' =
			VAR Acordos =
			    CALCULATE (
			        [Tentativas],
			        FILTER (
			            fato_tarefa,
			            fato_tarefa[relato_sucesso] = fato_tarefa[concluiu]
			        )
			    )
			RETURN
			    DIVIDE ( Acordos, [Tentativas] )
		formatString: 0.000
		displayFolder: Kappa

	/// Concordância esperada por acaso, a partir das marginais da matriz.
	measure 'Concordância por acaso' =
			VAR Total = [Tentativas]
			VAR RelatoSim = DIVIDE ( [Relataram sucesso], Total )
			VAR FeitoSim = DIVIDE ( [Concluíram], Total )
			RETURN
			    RelatoSim * FeitoSim + ( 1 - RelatoSim ) * ( 1 - FeitoSim )
		formatString: 0.000
		displayFolder: Kappa

	/// Kappa de Cohen: o quanto relato e observação concordam depois de
	/// descontar a concordância que aconteceria por acaso.
	measure 'Kappa de Cohen' =
			VAR Po = [Concordância observada]
			VAR Pe = [Concordância por acaso]
			RETURN
			    DIVIDE ( Po - Pe, 1 - Pe )
		formatString: 0.000
		displayFolder: Kappa

	/// Célula da matriz: relatou sucesso e de fato concluiu.
	measure 'Acertou o relato · concluiu' =
			CALCULATE (
			    [Tentativas],
			    fato_tarefa[relato_sucesso] = TRUE (),
			    fato_tarefa[concluiu] = TRUE ()
			)
		formatString: #,0
		displayFolder: Matriz

	/// Célula da matriz: disse que deu certo sem ter concluído.
	measure 'Errou o relato · não concluiu' =
			CALCULATE (
			    [Tentativas],
			    fato_tarefa[relato_sucesso] = TRUE (),
			    fato_tarefa[concluiu] = FALSE ()
			)
		formatString: #,0
		displayFolder: Matriz

	/// Célula da matriz: disse que não deu certo mas concluiu.
	measure 'Errou o relato · concluiu' =
			CALCULATE (
			    [Tentativas],
			    fato_tarefa[relato_sucesso] = FALSE (),
			    fato_tarefa[concluiu] = TRUE ()
			)
		formatString: #,0
		displayFolder: Matriz

	/// Célula da matriz: relatou fracasso e de fato não concluiu.
	measure 'Acertou o relato · não concluiu' =
			CALCULATE (
			    [Tentativas],
			    fato_tarefa[relato_sucesso] = FALSE (),
			    fato_tarefa[concluiu] = FALSE ()
			)
		formatString: #,0
		displayFolder: Matriz

