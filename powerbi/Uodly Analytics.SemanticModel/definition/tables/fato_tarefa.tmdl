	partition fato_tarefa = m
		mode: import
		source =
				let
				  Origem = Excel.Workbook(File.Contents(PastaDados & "\uodly_powerbi.xlsx"), null, true),
				  #"Navegação 1" = Origem{[Item = "fato_tarefa", Kind = "Sheet"]}[Data],
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(#"Navegação 1", [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"sessao_id", type text}, {"tarefa", type text}, {"concluiu", type logical}, {"tempo_s", Int64.Type}, {"relato_sucesso", type logical}, {"relato_nota", Int64.Type}, {"relato_falso_positivo", type logical}, {"resultado", type text}, {"relato", type text}})
				in
				  #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

